# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT (.env.local)
#
# Local development runs against the LOCAL Supabase stack, never production.
#
#   1. npm run local:start      (boots the Docker stack, applies migrations)
#   2. npm run local:status     (prints the local API URL + anon key)
#   3. Put those values below in .env.local
#   4. npm run local:seed-admin (creates the local Super Admin login)
#
# NEVER point local .env files to the Production Supabase project.
# The app refuses to start in dev mode if you do (src/supabase/client.ts).
#
# WARNING: `vercel env pull` OVERWRITES .env.local with hosted credentials —
# if you ever run it, restore the local values below afterwards.
#
# The anon key is safe to expose in client code — access is enforced by Row
# Level Security. Never put the service_role key here or in any VITE_*
# variable — it must only ever exist as an Edge Function secret, never
# shipped to the browser.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key-from-npm-run-local-status

# Lyca Mobile workspace (/lyca/...) — a SEPARATE Supabase project with its
# own LOCAL stack on ports 5532x, its own JWT secret and its own data:
#   npm run lyca:start   (boots it: same schema/functions as Adobe + Lyca's
#                         own migrations in workspaces/lyca/migrations)
#   npm run lyca:env     (prints these two lines)
#   npm run lyca:seed    (synthetic local Lyca test data)
# Optional: without them /lyca/... shows "unavailable" and never falls back
# to Adobe. Never Adobe's URL or key — the app refuses to start if so.
VITE_LYCA_SUPABASE_URL=http://127.0.0.1:55321
VITE_LYCA_SUPABASE_ANON_KEY=your-local-lyca-anon-key-from-npm-run-lyca-env

# Password for the local synthetic test accounts created by npm run lyca:seed.
LOCAL_TEST_ACCOUNTS_PASSWORD=choose-a-local-test-password-12+chars

# ---------------------------------------------------------------------------
# PRODUCTION
#
# Production values live ONLY in Vercel's Production environment variables
# (Vercel dashboard → adobe-longlist → Settings → Environment Variables):
#
#   VITE_SUPABASE_URL=<production project URL>
#   VITE_SUPABASE_ANON_KEY=<production anon key>
#
# and, once Lyca Mobile's own production project exists:
#
#   VITE_LYCA_SUPABASE_URL=<Lyca production project URL>
#   VITE_LYCA_SUPABASE_ANON_KEY=<Lyca production anon key>
#
# (Lyca's project, adfubeifnsgxwmpfslkt, is already in vercel.json's /lyca
# CSP.)
#
# They are never placed in any file in this repo.
# ---------------------------------------------------------------------------
